# Application Environment
APP_ENV=production
API_PREFIX=/api/v1

# Database (NeonDB PostgreSQL or Local SQLite fallback)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.c-2.us-east-2.aws.neon.tech/neondb?sslmode=require

# Security & Authentication
JWT_SECRET=your-secure-jwt-secret-key-change-in-production
ADMIN_API_KEY=your-admin-secret-key

# Groq LLM Configuration
LLM_PROVIDER=openai_compatible
LLM_API_KEY=gsk_your_primary_groq_api_key
LLM_FALLBACK_API_KEYS=gsk_fallback_key_1,gsk_fallback_key_2
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=1500

# Retrieval & RAG Parameters
RETRIEVAL_CANDIDATE_K=40
RERANK_TOP_N=30
FINAL_EVIDENCE_K=4
MIN_RETRIEVAL_SCORE=0.15
MIN_GROUNDING_SCORE=0.50
